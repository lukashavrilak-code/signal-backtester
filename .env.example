# Copy this file to .env and fill in your own keys. .env is git-ignored.
# In GitHub Actions the same names are stored as repository secrets.

# openFDA key (optional; only used for the drug label endpoint): https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# OpenRouter key (only for generating AI drafts manually): https://openrouter.ai/keys
OPENROUTER_API_KEY=
